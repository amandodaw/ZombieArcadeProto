[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://World/menu.gd" id="1"]

[sub_resource type="LabelSettings" id="1"]
font_size = 28
font_color = Color(0.95, 0.95, 0.95, 1)

[node name="Control" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.04, 0.04, 0.88)

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]

[node name="Margin" type="MarginContainer" parent="CenterContainer/Panel"]
theme_override_constants/margin_left = 26
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 26
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Panel/Margin"]
custom_minimum_size = Vector2(360, 0)
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
label_settings = SubResource("1")
horizontal_alignment = 1
text = "Has muerto"

[node name="Subtitle" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
horizontal_alignment = 1
text = "A: Reintentar  |  B: Salir"

[node name="Buttons" type="HBoxContainer" parent="CenterContainer/Panel/Margin/VBox"]
alignment = 1
theme_override_constants/separation = 10

[node name="ButtonRetry" type="Button" parent="CenterContainer/Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(140, 38)
text = "Reintentar"

[node name="ButtonQuit" type="Button" parent="CenterContainer/Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(140, 38)
text = "Salir"

[connection signal="pressed" from="CenterContainer/Panel/Margin/VBox/Buttons/ButtonRetry" to="." method="_on_Button_pressed"]
[connection signal="pressed" from="CenterContainer/Panel/Margin/VBox/Buttons/ButtonQuit" to="." method="_on_Button2_pressed"]
